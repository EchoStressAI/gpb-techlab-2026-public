{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    // Вывод уводится из корня намеренно.
    //
    // Проект ссылочный (composite), поэтому эмит ему отключать нельзя —
    // tsc отвечает TS6310. А без outDir `tsc -b` кладёт рядом с исходником
    // vite.config.js. Vite ищет конфиг по расширениям в порядке js → ts
    // и подхватывал бы скомпилированную копию: правка vite.config.ts
    // молча не применялась бы до следующей сборки.
    "outDir": "./node_modules/.tmp/node-config"
  },
  "include": ["vite.config.ts"]
}
